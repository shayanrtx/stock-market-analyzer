__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.cache/
build/
dist/
diagnostics/
portfolio.csv
watchlist.txt

# PHP app: secrets and runtime data never go to git
app/config/config.php
app/storage/*
!app/storage/.htaccess
!app/storage/cache/
app/storage/cache/*
!app/storage/cache/.gitkeep
!app/storage/logs/
app/storage/logs/*
!app/storage/logs/.gitkeep
